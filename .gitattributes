# Normaliza los finales de línea: evita los avisos de CRLF en cada commit
# y que los diffs salgan enteros al trabajar entre Windows y CI.
* text=auto eol=lf

*.bat       text eol=crlf
*.ps1       text eol=crlf
gradlew     text eol=lf
gradlew.bat text eol=crlf

*.png  binary
*.jpg  binary
*.webp binary
*.jar  binary
*.apk  binary
*.keystore binary
