{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar e instalar en el móvil",
      "detail": "Compila el APK y lo instala por Wi-Fi. Atajo: Ctrl+Shift+B",
      "type": "shell",
      "command": "./gradlew assembleDebug && adb install -r app/build/outputs/apk/debug/app-debug.apk",
      "options": {
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
          "ANDROID_HOME": "${env:USERPROFILE}\\Android\\Sdk"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Solo compilar",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "options": {
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
          "ANDROID_HOME": "${env:USERPROFILE}\\Android\\Sdk"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "./gradlew testDebugUnitTest",
      "options": {
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot",
          "ANDROID_HOME": "${env:USERPROFILE}\\Android\\Sdk"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Reconectar el móvil por Wi-Fi",
      "detail": "Si adb deja de verlo. El puerto cambia al reiniciar el móvil.",
      "type": "shell",
      "command": "adb mdns services",
      "options": {
        "env": { "ANDROID_HOME": "${env:USERPROFILE}\\Android\\Sdk" }
      },
      "problemMatcher": []
    }
  ]
}
