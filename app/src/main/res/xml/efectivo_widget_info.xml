<?xml version="1.0" encoding="utf-8"?>
<!--
  maxResizeWidth/Height hacen falta: sin declararlos, MagicOS aplica un tope propio
  mucho menor y el widget deja de poder estirarse a lo alto.

  El ancho maximo no se consigue igualmente. Se probo a dejar la declaracion identica
  a la del widget grande de WPS, el unico del movil que si llega, y el launcher sigue
  dando 4 columnas a uno y 5 al otro. Ver "Lo que no se pudo" en el README.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="800dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
